      ("rs1", 5, "rs"),
      ("f3", 3, "f3"),
      ("imm", 5, "imm"),
      ("opcode", 7, "op"),
    ),
    (
      "B",
      ("imm", 7, "imm"),
      ("rs2", 5, "rs"),
      ("rs1", 5, "rs"),
      ("f3", 3, "f3"),
      ("imm", 5, "imm"),
      ("opcode", 7, "op"),
    ),
  )
  let colors = (
    "op": luma(90%),
    "rs": luma(84%),
    "rd": luma(88%),
    "f3": luma(80%),
    "f7": luma(76%),
    "imm": luma(94%),
  )
  let unit = 0.42
  let row-h = 0.5
  let gap = 0.28
  canvas({
    let x0 = 0.6
    let top = 0.9
    for (idx, (fmt, ..parts)) in fields.enumerate() {
      let y = top - 0.4 - idx * (row-h + gap)
      draw.content(
        (x0 - 0.15, y - row-h / 2),
