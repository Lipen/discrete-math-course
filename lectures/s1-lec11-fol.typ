  columns: (1fr, 1fr),
  column-gutter: 0.8em,
  rule-card[$exists$E][$
    frac(exists x . thin phi(x) quad phi(a) tack.r C, C)
  $][$a$ свежий, в $C$ не входит.],
  rule-card[Подстановка][$
    frac(exists x . thin P(x) quad P(a) tack.r D, D)
  $][$phi(x) := P(x)$, $C := D$.],
)

