= Предикаты и кванторы

#focus-slide(
  ghost: $forall$,
  epigraph: [Математику можно определить как предмет, в котором мы никогда не знаем ни того, о чём говорим, ни того, истинно ли то, что мы говорим.],
  epigraph-author: [Бертран Рассел],
