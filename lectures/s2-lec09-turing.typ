  [#Red["цикл"]],
  table.cell(fill: colors.accent.transparentize(85%))[#Green[$+$]],
  [#Green[$+$]],
  [#Red["цикл"]],
  [#Red["цикл"]],
  [$M_3$],
  [#Green[$+$]],
  [#Red[$-$]],
  table.cell(fill: colors.accent.transparentize(85%))[#Green[$+$]],
  [#Green[$+$]],
  [#Red[$-$]],
  [$M_4$],
  [#Red["цикл"]],
