  columns: 3,
  align: (left, center, left),
  stroke: (x, y) => if y == 0 { (bottom: 0.8pt) },
  table.header([*Закон*], [*Результат*], [*Почему*]),
  [$aleph_0 + aleph_0$],
  [$aleph_0$],
  [чётные комнаты --- старым, нечётные --- новым],

  [$aleph_0 dot aleph_0$], [$aleph_0$], [пары нумеруются диагоналями],
