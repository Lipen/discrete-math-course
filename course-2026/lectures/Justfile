[private]
default:
    @just --list

files := """
    course-intro.typ
    lec-logic.typ
    lec-deduction.typ
    lec-fol.typ
    lec-sets.typ
    lec-relations.typ
    lec-functions.typ
    lec-cardinals.typ
    lec-orders.typ
    lec-graphs.typ
    lec-boolean.typ
    lec-circuits.typ
    lec-codes.typ
    lec-sat.typ
    lec-smt.typ
    lec-logic-programming.typ
    lec-matroids.typ
    lec-combinatorics.typ
    lec-number-theory.typ
    lec-probability.typ
    lec-generating-fns.typ
    lec-constructions.typ
    lec-automata.typ
    lec-context-free.typ
    lec-turing.typ
    lec-decidability.typ
    lec-lambda.typ
    lec-type-theory.typ
    lec-model.typ
    lec-intuitionism.typ
"""

# Compile all lectures
all:
    #!/usr/bin/env sh
    set -e
    for file in {{ replace(files, "\n", ' ') }}; do
        just _compile $file
    done

# Compile lectures in parallel
parallel:
    parallel -k -- just _compile {} ::: {{ replace(files, "\n", ' ') }}

# Compile one file
_compile *args:
    typst compile {{ args }}
