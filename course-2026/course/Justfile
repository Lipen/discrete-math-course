[private]
default:
    @just --list

# Build all course documents
all: syllabus topics-s1 topics-s2 program

# Working program (РПД)
program:
    pandoc program.md -o program.pdf --pdf-engine=xelatex -V mainfont="Libertinus Serif" -V lang=ru -V geometry:margin=2.5cm -V fontsize=11pt --standalone

# Course syllabus
syllabus:
    typst compile --root .. syllabus.typ

# Topics: semester 1
topics-s1:
    typst compile --root .. topics-s1.typ

# Topics: semester 2
topics-s2:
    typst compile --root .. topics-s2.typ
