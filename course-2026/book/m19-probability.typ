    columns: (auto, auto),
    stroke: (x, y) => if y == 0 { (bottom: 0.8pt) },
    table.header([$n$], [$P("совпадение")$]),
    [10], [11.7%],
    [20], [41.1%],
    [23], [50.7%],
    [30], [70.6%],
    [40], [89.1%],
    [50], [97.0%],
