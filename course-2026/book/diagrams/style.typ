// Единый дизайн-слой для всех диаграмм книги.
// Импортируется файлами diagrams/mXX.typ.
// Один источник истины для цветов, весов штрихов и размеров текста:
// диаграммы из разных глав выглядят как один набор.

// ── Палитра (гармонизирована с темой книги: oklch(55%, 0.16, 230deg)) ──
#let c-ink      = oklch(27%, 0.02, 260deg)  // текст внутри узлов
#let c-muted    = luma(45%)                   // второстепенный текст
#let c-edge     = oklch(40%, 0.02, 265deg)    // структурные рёбра
#let c-bd       = oklch(56%, 0.07, 250deg)    // границы узлов
#let c-fl       = oklch(91%, 0.03, 250deg)    // заливка узлов (голубая)
#let c-conn     = oklch(91%, 0.04, 45deg)     // связки и логические узлы (персиковая)
#let c-atom     = oklch(91%, 0.025, 155deg)   // атомы и базовые узлы (зелёная)
#let c-warn     = oklch(88%, 0.06, 22deg)     // выделение и противоречие (тёплая)
#let c-accent   = oklch(55%, 0.16, 230deg)    // акцент книги
#let c-hot      = oklch(56%, 0.20, 22deg)     // тёплый акцент: мосты, разрезы, контрпримеры

// ── Веса штрихов ──
#let t-bd = 0.8pt   // граница узла
#let t-ed = 0.7pt   // ребро
#let t-hi = 1.1pt   // выделенное ребро
#let t-hr = 0.3pt   // сетка и волосяные линии

// ── Размеры текста ──
#let s-node = 0.8em    // метка внутри узла
#let s-cap  = 0.7em    // подпись и вспомогательная метка
#let s-tiny = 0.55em   // индексы и числа на рёбрах
