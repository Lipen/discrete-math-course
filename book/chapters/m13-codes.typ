  columns: (auto, auto, 1fr),
  align: (left, center, left),
  stroke: (x, y) => if y == 0 { (bottom: 0.8pt) },
  table.header([Синдром], [Чётность], [Что это и что делать]),
  [$s = 0$], [сошлась], [Ошибок нет],
  [$s = 0$],
  [не сошлась],
  [Перевёрнут сам бит чётности (позиция 8) --- исправляем его],

